# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Application
APP_NAME=Enterprise Multi-Agent AI Platform
APP_ENV=development
APP_DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# LLM
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database
CHROMA_DB_PATH=./data/chromadb

# Logging
LOG_LEVEL=INFO